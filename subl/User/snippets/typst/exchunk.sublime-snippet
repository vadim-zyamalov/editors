<snippet>
	<content><![CDATA[
#set document(title: [Упражнения: ${1:name}])
#import "@preview/exercise-bank:0.8.0": *
#import "@local/neat-document:0.1.0": *
#import "@preview/theorion:0.6.0": *
#import "@preview/efilrst:0.4.0" as efilrst

#show: neat-document.with(size: 10pt)
#show: show-theorion
#show ref: efilrst.show-rule

#let tasks = efilrst.reflist.with(
  list-style: asbuk-num,
  ref-style: asbuk-num.with(ref: true),
)

#exo-setup(
  exercise-label: "Упр.",
  solution-label: "Решение",
  correction-label: "Комментарий",
  corr-loc: "end-chapter",
  badge-style: (label, number, font-size, color, is-solution) => {
    box(inset: 0.25em)[*№ #number*]
  },
  number-prefix: "heading",
  counter-reset: "chapter",
)

#set enum(
  numbering: (..n) => {
    n = n.pos()
    let level = n.len()
    if level == 1 {
      asbuk(n.at(0)) + ")"
    } else if level == 2 {
      numbering("1.", ..n.slice(1))
    } else {
      numbering("1.", ..n)
    }
  },
  full: true,
)

// BEGIN

${0}

// END
]]></content>
	<!-- Optional: Set a tabTrigger to define how to trigger the snippet -->
	<tabTrigger>exchunk</tabTrigger>
	<!-- Optional: Set a scope to limit where the snippet will trigger -->
	<scope>text.typst</scope>
</snippet>
